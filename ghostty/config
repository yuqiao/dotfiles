# Ghostty 终端配置文件
#

link-url = true

# ============================================================================
# 字体配置
# ============================================================================
font-family = Hack Nerd Font
font-size = 14

theme = "Catppuccin Mocha"
#theme = light:Catppuccin Latte, dark:Catppuccin Mocha

# ============================================================================
# 窗口配置
# ============================================================================

window-width = 120
window-height = 40
window-padding-x = 2
window-padding-y = 0
window-theme = auto

#macos-titlebar-style = tabs
macos-titlebar-style = hidden 
background-opacity = 0.85
background-blur-radius = 20

# 指定背景图片的路径（建议使用绝对路径）
background-image = /Users/qiaoyu/tools/lownagios.png
background-image-fit = cover
background-image-opacity = 0.35

#background-blur-radius = 20


# ==========================================
# 性能与滚动缓冲 (针对大模型开发优化)
# ==========================================
# LLM 开发经常遇到超长的 Log 和 Context 输出，调大历史记录限制
#scrollback-limit = 1000000
scrollback-limit = 50000000

# 允许鼠标平滑滚动
mouse-scroll-multiplier = 2


copy-on-select = clipboard
mouse-hide-while-typing = true
clipboard-read = allow
clipboard-write = allow

# --- 桌面通知 ---
# 让 Ghostty 在后台 AI 生成完成/报 Bell 时触发系统通知
desktop-notifications = true
# 链接检测
link-url = true

# ============================================================================
# 快捷键配置 - macOS 风格（iTerm2 兼容）
# ============================================================================

# 新建标签页
keybind = cmd+t=new_tab

# 关闭标签页
keybind = cmd+w=close_surface

# 新建窗口
keybind = cmd+n=new_window

# 垂直分屏
keybind = cmd+d=new_split:right

# 水平分屏
keybind = cmd+shift+d=new_split:down

# 下一个标签页
keybind = cmd+]=next_tab

# 上一个标签页
keybind = cmd+[=previous_tab

# 快速切换 Tab (Cmd + 1..5)
keybind = cmd+1=goto_tab:1
keybind = cmd+2=goto_tab:2
keybind = cmd+3=goto_tab:3
keybind = cmd+4=goto_tab:4
keybind = cmd+5=goto_tab:5

# 全屏切换
keybind = cmd+enter=toggle_fullscreen

# 打开配置文件
keybind = cmd+comma=open_config

# 焦点切换
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right

# 调整窗口大小
keybind = cmd+alt+shift+up=resize_split:up,20
keybind = cmd+alt+shift+down=resize_split:down,20
keybind = cmd+alt+shift+left=resize_split:left,20
keybind = cmd+alt+shift+right=resize_split:right,20

# 字体大小调整
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size

# ==========================================
# 1. 启动命令：自动关联或创建 Tmux 会话
# ==========================================
# 每次打开 Ghostty 窗口时，自动尝试 attach 到名为 "dev" 的会话。
# 如果 "dev" 不存在，则新建一个。
# 这样即便你误关了 Ghostty 窗口，重新打开时一切都在原处。
# command = /opt/homebrew/bin/tmux new-session -A -s dev
#

# --- 原生分屏快捷键配置 ---
# --- 流派二：Tmux 象形风格 ---
keybind = super+\=new_split:right
keybind = super+-=new_split:down

# 焦点切换
keybind = super+left=goto_split:left
keybind = super+right=goto_split:right
keybind = super+up=goto_split:top
keybind = super+down=goto_split:bottom

# Cmd+W 保持系统默认（关 Tab/窗口）
# Cmd+Shift+W 仅关闭当前分屏
keybind = super+shift+w=close_surface

