# ===========================================
# 通用 .gitignore 配置
# ===========================================

# Git
.git

# ===========================================
# 操作系统生成的文件
# ===========================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump
[Dd]esktop.ini

# Linux
*~
.directory

# ===========================================
# 编辑器和 IDE
# ===========================================

# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains IDEs
.idea/
*.iml
*.ipr
*.iws
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*.swn
*~
.netrwhist

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# ===========================================
# 编程语言临时文件
# ===========================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work
go.work.sum

# Rust
target/
Cargo.lock
**/*.rs.bk

# Java
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# ===========================================
# 构建输出和依赖目录
# ===========================================

bin/
obj/
*.o
*.a
*.lib
*.pdb
*.ilk
*.obj

# ===========================================
# 日志和临时文件
# ===========================================

logs/
*.log
*.tmp
*.temp
*.bak
*.cache
*.pid
*.seed
*.pid.lock

# ===========================================
# 环境配置和密钥文件
# ===========================================

.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crt
secrets/
credentials/

# ===========================================
# 数据库文件
# ===========================================

*.db
*.sqlite
*.sqlite3
*.sql

# ===========================================
# 其他常见忽略项
# ===========================================

# 归档文件
*.zip
*.tar.gz
*.tar
*.gz
*.rar
*.7z

# 备份文件
*.backup
*.old
*.orig

# 临时目录
tmp/
temp/
.cache/

# 文档生成
docs/_build/
site/

# 测试覆盖率
coverage/
.nyc_output/
